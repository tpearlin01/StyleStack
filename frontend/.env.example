# StyleStack Frontend Environment Variables
# For Azure Static Web Apps / Azure App Service or local development

# Backend API Base URL
# Local development default: http://localhost:5000
# Production Azure App Service: https://<your-app-service-name>.azurewebsites.net
VITE_API_BASE_URL=http://localhost:5000

# Razorpay Public Key ID (Test Mode)
# Safe to expose in frontend client code (Public Key ID only; NEVER expose Key Secret)
# Matches RAZORPAY_KEY_ID from your Razorpay dashboard
VITE_RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
