# StyleStack Backend Environment Variables
# Azure App Service sets process.env.PORT automatically (defaults to 5000 locally)
PORT=5000

# Azure Cosmos DB (MongoDB API) or standard MongoDB connection string
# Example: mongodb://<account>:<key>@<account>.mongo.cosmos.azure.com:10255/?ssl=true&replicaSet=globaldb&retrywrites=false
# Leave empty to fall back gracefully to local JSON mock data store
MONGODB_URI=

# JWT Secret for authentication tokens
JWT_SECRET=your_jwt_secret_key_here

# Frontend Client URL for CORS (Azure Static Web Apps URL or localhost)
# Example: https://stylestack.azurestaticapps.net,http://localhost:5173
CLIENT_URL=http://localhost:5173

# ==============================================================================
# PHASE 1: Razorpay Payment Gateway (Test Mode)
# Create keys from https://dashboard.razorpay.com/app/keys in Test Mode
# ==============================================================================
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourKeySecretHere

# ==============================================================================
# PHASE 2: Gmail SMTP Notifications (Nodemailer)
# Generate a 16-character Google App Password from:
# https://myaccount.google.com/apppasswords
# ==============================================================================
EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_16_char_app_password
